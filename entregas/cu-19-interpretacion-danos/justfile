# Plan v3, AC-006–AC-009:
# https://github.com/lvckss/piia2-26/issues/64#issuecomment-6576322792
app := 'app'
cardd_url := env('CARDD_URL', 'https://drive.google.com/file/d/1TXnFJUyNsxciAz4pxKtwD8lJ1uWzcdBK/view?usp=sharing')

# Mostrar los comandos disponibles.
default:
    @just --list

# Arrancar React + Vite (dependencias Bun instaladas previamente).
frontend:
    cd {{ quote(app + '/frontend') }} && bun run dev

# Arrancar Bun + Hono (requiere DATABASE_URL y PostgreSQL disponible).
backend:
    cd {{ quote(app) }} && bun run dev

# Preparar el entorno Python y descargar/verificar CARDD sin activar el venv.
cardd:
    @test -x .venv-cardd/bin/python || python3 -m venv .venv-cardd
    @.venv-cardd/bin/python -m pip install --disable-pip-version-check --quiet -r scripts/requirements-cardd.txt
    @.venv-cardd/bin/python scripts/download_cardd.py --url {{ quote(cardd_url) }}

# Preparar PostgreSQL en Docker, sus tablas y la conexión local de la app.
db-init:
    python3 scripts/init_postgres.py

# Arrancar la PostgreSQL compartida (explorador y RAG) y esperar a que esté lista.
db-up:
    docker compose --env-file .env.postgres up -d --wait postgres

# Abrir psql en la misma base que usarán backend y RAG.
db-psql:
    docker compose --env-file .env.postgres exec postgres sh -c 'exec psql -U "$POSTGRES_USER" -d "$POSTGRES_DB"'

# Detener PostgreSQL conservando el volumen y todos sus datos.
db-stop:
    docker compose --env-file .env.postgres stop postgres

# Instalar las dependencias Python del RAG en un entorno local aislado.
rag-setup:
    @test -x .venv-rag/bin/python || python3 -m venv .venv-rag
    @.venv-rag/bin/python -m pip install --disable-pip-version-check --quiet -r app/agentes/agente_recuperacion/requirements-rag.txt
    @TIKTOKEN_CACHE_DIR=.cache-rag/tiktoken .venv-rag/bin/python -c 'import tiktoken; tiktoken.get_encoding("cl100k_base")'

# Contar documentos/fragmentos y estimar tokens/coste, sin DB ni llamadas de pago.
rag-plan model="both":
    .venv-rag/bin/python app/agentes/agente_recuperacion/indexar_normativa.py --model {{ quote(model) }}

# Indexar explícitamente con un presupuesto total en USD (small/large/both).
rag-index budget model="both":
    .venv-rag/bin/python app/agentes/agente_recuperacion/indexar_normativa.py --model {{ quote(model) }} --execute --max-cost-usd {{ quote(budget) }}

# Probar el RAG con una PostgreSQL Docker desechable y proveedores simulados.
rag-test:
    .venv-rag/bin/python app/agentes/agente_recuperacion/probar_indexado.py --postgres
