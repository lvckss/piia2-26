# Plan v3, AC-006–AC-009:
# https://github.com/lvckss/piia2-26/issues/64#issuecomment-6576322792
app := 'app'
cardd_url := env('CARDD_URL', 'https://drive.google.com/file/d/1TXnFJUyNsxciAz4pxKtwD8lJ1uWzcdBK/view?usp=sharing')

# Mostrar los comandos disponibles.
default:
    @just --list

# Arrancar React + Vite (dependencias Bun instaladas previamente).
frontend:
    cd {{ quote(app + '/frontend') }} && bun run dev

# Arrancar Bun + Hono (requiere DATABASE_URL y PostgreSQL disponible).
backend:
    cd {{ quote(app) }} && bun run dev

# Preparar el entorno Python y descargar/verificar CARDD sin activar el venv.
cardd:
    @test -x .venv-cardd/bin/python || python3 -m venv .venv-cardd
    @.venv-cardd/bin/python -m pip install --disable-pip-version-check --quiet -r scripts/requirements-cardd.txt
    @.venv-cardd/bin/python scripts/download_cardd.py --url {{ quote(cardd_url) }}

# Generar una contraseña local y la configuración Docker sin sobrescribirla.
db-configure:
    python3 scripts/migrate_postgres.py --configure

# Arrancar la PostgreSQL compartida (explorador y RAG) y esperar a que esté lista.
db-up:
    docker compose --env-file .env.postgres up -d --wait postgres

# Ver el plan de copia; no cambia datos ni conexiones.
db-migration-plan:
    python3 scripts/migrate_postgres.py

# Copiar la BD local a un destino vacío y conectar la app solo tras verificar.
db-migrate:
    python3 scripts/migrate_postgres.py --execute --update-app-env

# Crear las tablas del explorador solo para una instalación nueva sin datos.
db-init:
    docker compose --env-file .env.postgres exec -T postgres sh -c 'exec psql -v ON_ERROR_STOP=1 --single-transaction -U "$POSTGRES_USER" -d "$POSTGRES_DB"' < app/bd/schema.sql

# Abrir psql en la misma base que usarán backend y RAG.
db-psql:
    docker compose --env-file .env.postgres exec postgres sh -c 'exec psql -U "$POSTGRES_USER" -d "$POSTGRES_DB"'

# Detener PostgreSQL conservando el volumen y todos sus datos.
db-stop:
    docker compose --env-file .env.postgres stop postgres
